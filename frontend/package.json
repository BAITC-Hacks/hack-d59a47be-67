{
  "name": "career-quest-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.ts && prettier --write src/api/schema.ts",
    "start": "node scripts/start.mjs",
    "start:demo": "node scripts/start.mjs --demo",
    "format:check": "prettier --check src vite.config.ts scripts/start.mjs package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
