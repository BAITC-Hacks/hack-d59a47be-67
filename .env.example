# scripts/dev reads .env using python-dotenv (never shell eval).
APP_ENV=development
DATABASE_PATH=var/career_quest.sqlite3
ALLOWED_ORIGINS='["http://127.0.0.1:8000","http://localhost:8000","http://localhost:5173"]'
SESSION_TTL_SECONDS=3600
# staging automatically enables Secure; use HTTPS + same-site frontend/reverse proxy.
# COOKIE_SECURE=true
SQLITE_WAL=false
# Set true only after verifying a local disk on ONE host, then opt into WAL above.
SQLITE_LOCAL_DISK=false
AI_ENABLED=false
# Runtime-only optional AI settings; never commit a key or bake it into the image.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# AI deadline must fit inside the backend adapter's 7-second timeout.
AI_TIMEOUT_SECONDS=6.0
# scripts/dev resolves git HEAD if this value is absent/unknown.
COMMIT_SHA=unknown
# No default accounts or passwords. Use CLI create-account with an interactive prompt.
# Optional public demonstration uses a separate, empty registry DB and per-visitor fictional data.
PUBLIC_DEMO_MODE=false
# STATIC_FILES_PATH=frontend/dist
# PUBLIC_BASE_URL=https://your-service.onrender.com
# Render's RENDER_EXTERNAL_URL is detected automatically; never use a wildcard origin.
