# scripts/dev reads .env using python-dotenv (never shell eval).
APP_ENV=development
DATABASE_PATH=var/career_quest.sqlite3
ALLOWED_ORIGINS='["http://127.0.0.1:8000","http://localhost:8000","http://localhost:5173"]'
SESSION_TTL_SECONDS=3600
# staging automatically enables Secure; use HTTPS + same-site frontend/reverse proxy.
# COOKIE_SECURE=true
SQLITE_WAL=false
# Set true only after verifying a local disk on ONE host, then opt into WAL above.
SQLITE_LOCAL_DISK=false
AI_ENABLED=false
# scripts/dev resolves git HEAD if this value is absent/unknown.
COMMIT_SHA=unknown
# No default accounts or passwords. Use CLI create-account with an interactive prompt.
