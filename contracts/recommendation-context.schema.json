{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:career-quest:schema:recommendation-context:1.0",
  "title": "Prepared recommendation context v1.0",
  "description": "Trusted backend-derived input. Identifiers and all cross-field calculations require semantic validation; text values remain untrusted data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "data_revision",
    "policy_version",
    "as_of_date",
    "employee",
    "target",
    "planning_state",
    "candidates",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "context_id": {
      "$ref": "#/$defs/id"
    },
    "data_revision": {
      "$ref": "#/$defs/id"
    },
    "policy_version": {
      "$ref": "#/$defs/id"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "employee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "employee_id",
        "role",
        "grade",
        "current_skills"
      ],
      "properties": {
        "employee_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "grade": {
          "$ref": "#/$defs/grade"
        },
        "current_skills": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/level"
          }
        }
      }
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/target"
        },
        {
          "type": "null"
        }
      ]
    },
    "planning_state": {
      "enum": [
        "actionable",
        "target_satisfied",
        "no_target",
        "no_candidates",
        "insufficient_evidence"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "planning_state": {
            "const": "actionable"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/target"
          },
          "candidates": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 3
          }
        }
      },
      "else": {
        "properties": {
          "candidates": {
            "maxItems": 0
          },
          "evidence": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planning_state": {
            "const": "no_target"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "$ref": "#/$defs/target"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "grade": {
      "type": "string",
      "enum": [
        "Junior",
        "Middle",
        "Senior",
        "Lead"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "grade",
        "source",
        "required_skills",
        "critical_skills"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "grade": {
          "$ref": "#/$defs/grade"
        },
        "source": {
          "enum": [
            "career_goal",
            "next_grade"
          ]
        },
        "required_skills": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/level"
          }
        },
        "critical_skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "title",
        "type",
        "format",
        "duration_hours",
        "session_date",
        "projected_gains",
        "evidence_ids",
        "features"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "enum": [
            "course",
            "workshop",
            "mentoring",
            "certification",
            "meetup"
          ]
        },
        "format": {
          "enum": [
            "online",
            "offline",
            "self_paced"
          ]
        },
        "duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "session_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "projected_gains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "current_level",
              "result_level",
              "effective_gain",
              "target_gap_reduction",
              "critical"
            ],
            "properties": {
              "skill_id": {
                "$ref": "#/$defs/id"
              },
              "current_level": {
                "$ref": "#/$defs/level"
              },
              "result_level": {
                "$ref": "#/$defs/level"
              },
              "effective_gain": {
                "$ref": "#/$defs/level"
              },
              "target_gap_reduction": {
                "$ref": "#/$defs/level"
              },
              "critical": {
                "type": "boolean"
              }
            }
          },
          "minItems": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical_gap_gain",
            "target_gap_gain",
            "history_fit",
            "effort_cost"
          ],
          "properties": {
            "critical_gap_gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "target_gap_gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "history_fit": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "effort_cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/gradeEvidence"
        },
        {
          "$ref": "#/$defs/gapEvidence"
        },
        {
          "$ref": "#/$defs/targetEvidence"
        },
        {
          "$ref": "#/$defs/historyEvidence"
        }
      ]
    },
    "gradeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "event_id",
        "category",
        "current_role",
        "current_grade",
        "event_target_roles",
        "event_target_grades"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "const": "grade"
        },
        "current_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "current_grade": {
          "$ref": "#/$defs/grade"
        },
        "event_target_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "event_target_grades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grade"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "gapEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "event_id",
        "category",
        "skill_id",
        "current_level",
        "required_level",
        "gap",
        "effective_gain",
        "target_gap_reduction"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "const": "skill_gap"
        },
        "skill_id": {
          "$ref": "#/$defs/id"
        },
        "current_level": {
          "$ref": "#/$defs/level"
        },
        "required_level": {
          "$ref": "#/$defs/level"
        },
        "gap": {
          "$ref": "#/$defs/level"
        },
        "effective_gain": {
          "$ref": "#/$defs/level"
        },
        "target_gap_reduction": {
          "$ref": "#/$defs/level"
        }
      }
    },
    "targetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "event_id",
        "category",
        "target_role",
        "target_grade",
        "skill_id",
        "required_level",
        "critical"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "const": "target_requirement"
        },
        "target_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "target_grade": {
          "$ref": "#/$defs/grade"
        },
        "skill_id": {
          "$ref": "#/$defs/id"
        },
        "required_level": {
          "$ref": "#/$defs/level"
        },
        "critical": {
          "type": "boolean"
        }
      }
    },
    "historyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "event_id",
        "category",
        "scope",
        "event_type",
        "event_format",
        "window_start",
        "window_end",
        "sample_size",
        "completed",
        "in_progress",
        "dropped",
        "no_show",
        "declined",
        "overdue"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "const": "history"
        },
        "scope": {
          "enum": [
            "event",
            "type_and_format"
          ]
        },
        "event_type": {
          "enum": [
            "course",
            "workshop",
            "mentoring",
            "certification",
            "meetup"
          ]
        },
        "event_format": {
          "enum": [
            "online",
            "offline",
            "self_paced"
          ]
        },
        "window_start": {
          "type": "string",
          "format": "date"
        },
        "window_end": {
          "type": "string",
          "format": "date"
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        },
        "no_show": {
          "type": "integer",
          "minimum": 0
        },
        "declined": {
          "type": "integer",
          "minimum": 0
        },
        "overdue": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
