{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from backend.app.contracts.RecommendationContext; do not edit by hand.",
  "$defs": {
    "AnonymizedProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Ref",
          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "grade": {
          "enum": [
            "Junior",
            "Middle",
            "Senior",
            "Lead"
          ],
          "title": "Grade",
          "type": "string"
        }
      },
      "required": [
        "profile_ref",
        "role",
        "grade"
      ],
      "title": "AnonymizedProfile",
      "type": "object"
    },
    "EligibleCandidate": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/SkillEffect"
          },
          "title": "Effects",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "effects",
        "evidence_ids"
      ],
      "title": "EligibleCandidate",
      "type": "object"
    },
    "EvidenceFact": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "skill",
            "gap",
            "goal",
            "candidate",
            "history"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "fact": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Fact",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "subject_id",
        "fact"
      ],
      "title": "EvidenceFact",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "target_role": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Role",
          "type": "string"
        },
        "target_grade": {
          "enum": [
            "Junior",
            "Middle",
            "Senior",
            "Lead"
          ],
          "title": "Target Grade",
          "type": "string"
        }
      },
      "required": [
        "target_role",
        "target_grade"
      ],
      "title": "Goal",
      "type": "object"
    },
    "SkillEffect": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "before": {
          "maximum": 5,
          "minimum": 0,
          "title": "Before",
          "type": "number"
        },
        "after": {
          "maximum": 5,
          "minimum": 0,
          "title": "After",
          "type": "number"
        },
        "delta": {
          "maximum": 5,
          "minimum": -5,
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "skill_id",
        "before",
        "after",
        "delta"
      ],
      "title": "SkillEffect",
      "type": "object"
    },
    "SkillGap": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "current_level": {
          "maximum": 5,
          "minimum": 0,
          "title": "Current Level",
          "type": "number"
        },
        "target_level": {
          "maximum": 5,
          "minimum": 0,
          "title": "Target Level",
          "type": "number"
        },
        "gap": {
          "maximum": 5,
          "minimum": 0,
          "title": "Gap",
          "type": "number"
        }
      },
      "required": [
        "skill_id",
        "current_level",
        "target_level",
        "gap"
      ],
      "title": "SkillGap",
      "type": "object"
    },
    "SkillLevel": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "level": {
          "maximum": 5,
          "minimum": 0,
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "skill_id",
        "level"
      ],
      "title": "SkillLevel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1",
      "default": "1",
      "title": "Contract Version",
      "type": "string"
    },
    "data_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Data Version",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    },
    "scenario_date": {
      "format": "date",
      "title": "Scenario Date",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/AnonymizedProfile"
    },
    "goal": {
      "$ref": "#/$defs/Goal"
    },
    "current_skills": {
      "items": {
        "$ref": "#/$defs/SkillLevel"
      },
      "title": "Current Skills",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/SkillGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "eligible_candidates": {
      "items": {
        "$ref": "#/$defs/EligibleCandidate"
      },
      "title": "Eligible Candidates",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/EvidenceFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "limit": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "data_version",
    "state_version",
    "scenario_date",
    "profile",
    "goal",
    "current_skills",
    "gaps",
    "eligible_candidates",
    "facts"
  ],
  "title": "RecommendationContext",
  "type": "object"
}
