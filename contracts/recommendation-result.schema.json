{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from backend.app.contracts.RecommendationResult; do not edit by hand.",
  "$defs": {
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "RecommendationSelection": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        }
      },
      "required": [
        "event_id",
        "explanation"
      ],
      "title": "RecommendationSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "no_candidates",
        "not_configured",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "engine": {
      "enum": [
        "none",
        "oleg"
      ],
      "title": "Engine",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/RecommendationSelection"
      },
      "maxItems": 3,
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "status",
    "engine",
    "recommendations"
  ],
  "title": "RecommendationResult",
  "type": "object"
}
